{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git push *": "deny",
      "git force *": "deny",
      "rm *": "ask",
      "wrangler *": "ask",
      "gcloud *": "ask",
      "gcfu *": "ask",
      "aws *": "ask",
      "docker push *": "ask",
      "docker deploy *": "ask",
      "kubectl *": "ask",
      "helm *": "ask",
      "terraform apply *": "ask",
      "terraform destroy *": "ask",
      "serverless deploy *": "ask"
    }
  },
  "formatter": {
    "black": {
      "command": ["black", "$FILE"],
      "extensions": [".py", ".pyi"]
    },
    "biome": {
      "command": ["biome", "check", "--write", "$FILE"],
      "extensions": [".js", ".jsx", ".ts", ".tsx", ".json", ".jsonc", ".css", ".scss"]
    }
  },
  "lsp": {
    "biome": {
      "command": ["biome", "lsp-proxy"],
      "extensions": [".js", ".jsx", ".ts", ".tsx", ".json", ".jsonc", ".css"]
    }
  },
  "mcp": {
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "plugin": [
    "opencode-pty",
    "opencode-skills",
  ]
}
