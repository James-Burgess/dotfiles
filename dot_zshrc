if ! infocmp "$TERM" >/dev/null 2>&1; then
  export TERM=xterm-256color
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
zstyle ':omz:update' mode disabled

plugins=(
  git
  docker
  docker-compose
  golang
  pip
  rust
  aws
  gcloud
  kubectl
  terraform
  helm
  tmux
  nvm
  npm
  command-not-found
  extract
  ssh-agent
  history
  z
)

source $ZSH/oh-my-zsh.sh

export EDITOR='nvim'
export VISUAL='nvim'
export GOPATH="$HOME/go"
export CARGO_HOME="$HOME/.cargo"
export NVM_DIR="$HOME/.nvm"
export PYENV_ROOT="$HOME/.pyenv"
export BUN_INSTALL="$HOME/.bun"

export PATH="$HOME/bin:$HOME/.local/bin:$HOME/dev-setup/bin:$GOPATH/bin:$CARGO_HOME/bin:$BUN_INSTALL/bin:/usr/local/bin:$PATH"

type node &>/dev/null && export PATH="$(dirname $(which node)):$PATH"
[ -d "$PYENV_ROOT/bin" ] && export PATH="$PYENV_ROOT/bin:$PATH"

. "$HOME/.cargo/env" 2>/dev/null
. "$HOME/.atuin/bin/env" 2>/dev/null

[ -f "$HOME/google-cloud-sdk/path.zsh.inc" ] && . "$HOME/google-cloud-sdk/path.zsh.inc"
[ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ] && . "$HOME/google-cloud-sdk/completion.zsh.inc"

[ -e "$HOME/lib/oracle-cli/lib/python3.12/site-packages/oci_cli/bin/oci_autocomplete.sh" ] && source "$HOME/lib/oracle-cli/lib/python3.12/site-packages/oci_cli/bin/oci_autocomplete.sh"

# ── Shell options ──────────────────────────────────────────────────────────
setopt AUTOCD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt EXTENDED_GLOB
setopt NO_BEEP
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY

HISTSIZE=50000
SAVEHIST=50000

# ── Starship prompt ────────────────────────────────────────────────────────
type starship &>/dev/null && eval "$(starship init zsh)"

# ── zoxide (smart cd) ──────────────────────────────────────────────────────
type zoxide &>/dev/null && eval "$(zoxide init zsh)"

# ── atuin (shell history) ──────────────────────────────────────────────────
type atuin &>/dev/null && eval "$(atuin init zsh --disable-up-arrow)"

# ── fzf ────────────────────────────────────────────────────────────────────
export FZF_DEFAULT_COMMAND='fdfind --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fdfind --type d --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
if type fzf &>/dev/null; then
  if fzf --zsh &>/dev/null 2>&1; then
    source <(fzf --zsh)
  else
    source /usr/share/doc/fzf/examples/key-bindings.zsh 2>/dev/null
    source /usr/share/doc/fzf/examples/completion.zsh 2>/dev/null
  fi
fi

# ── lesspipe ───────────────────────────────────────────────────────────────
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# ── Aliases ────────────────────────────────────────────────────────────────
type batcat &>/dev/null && alias cat='batcat --paging=never'
type eza &>/dev/null && alias ls='eza --icons --group-directories-first'
type eza &>/dev/null && alias ll='eza -l --icons --git --header'
type eza &>/dev/null && alias la='eza -a --icons'
type eza &>/dev/null && alias lt='eza --tree --icons --level=2'
type eza &>/dev/null && alias lta='eza --tree --icons --all'
type fdfind &>/dev/null && alias fd='fdfind'
type rg &>/dev/null && alias grep='rg'
type delta &>/dev/null && alias diff='delta'

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias c='clear'
alias h='history'
alias ports='ss -tulanp'
alias ip='ip -c a'
alias reload='exec zsh'
alias update='sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y'

# alert for long running commands; use like so: sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history | tail -n1 | sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# docker
alias d='docker'
alias dc='docker compose'
alias dps='docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"'

# git
alias g='git'
alias gs='git status'
alias gp='git push'
alias gl='git pull'
alias gd='git diff'
alias gc='git commit'
alias gca='git commit --amend'
alias gco='git checkout'
alias gb='git branch'
alias gst='git stash'
alias glog='git log --oneline --graph --all'

# tmux
alias t='tmux'
alias ta='tmux attach -t'
alias tn='tmux new -s'
alias tl='tmux ls'

# ── nvm lazy load ──────────────────────────────────────────────────────────
if [ -s "$NVM_DIR/nvm.sh" ]; then
  export NVM_DIR="$HOME/.nvm"
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
fi

# ── pyenv ──────────────────────────────────────────────────────────────────
if type pyenv &>/dev/null; then
  eval "$(pyenv init - --no-rehash zsh)"
fi

# ── gpg agent ──────────────────────────────────────────────────────────────
export GPG_TTY=$(tty)
gpg-connect-agent /bye 2>/dev/null || true
